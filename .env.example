# 公開用サンプル。秘密情報や本番値をこのファイルに記載しないでください。
# 未設定時はブラウザで現在開いているURLの /open を共有します。
# iOSで共有・Universal Linksを試す場合は自分のHTTPS公開先 /open を設定。
# VITE_ の値はブラウザへ配布されるため、秘密情報を入れないでください。
VITE_PUBLIC_SHARE_BASE=

# 自分のApple Developer Team ID + 公開用Bundle ID。未設定なら関連付けを無効化。
# 形式: TEAM_ID.com.example.tomotype
APPLE_APP_ID=

# 自分のApp Store製品ページURL。未設定ならストアボタンを無効化。
APP_STORE_URL=
